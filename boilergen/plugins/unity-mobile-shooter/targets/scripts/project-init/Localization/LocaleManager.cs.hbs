// Auto-generated by Boilergen unity-mobile-shooter plugin (project-init target)
// Lightweight JSON-backed localization for Unity mobile FPS projects.
//
// Usage:
//   1. Drop this file into Assets/_Project/Scripts/Localization/
//   2. Place Resources/Locales/en.json + ru.json + kk.json (run Localization
//      Assistant: `localization-assistant fill --target ru.json kk.json`)
//   3. In any UI script: text.text = LocaleManager.Get("ui.matchmaking.searching");
//   4. To switch language at runtime: LocaleManager.SetLocale("ru");
//      (also fires LocaleManager.OnLocaleChanged so UIs can re-translate)
//
// Why not Unity Localization Package?
// - Smaller surface, ~80 LOC instead of a multi-MB UPM dep
// - Resources.Load is fine for <50 KB JSON files (Flump's UI is ~16 strings)
// - Switch to UPM Localization later if asset-variant translations needed

using System;
using System.Collections.Generic;
using UnityEngine;

namespace YourGame.Localization
{
    public static class LocaleManager
    {
        public const string DefaultLocale = "en";
        public const string PlayerPrefsKey = "boilergen.locale";

        public static event Action OnLocaleChanged;

        private static string _currentLocale = DefaultLocale;
        private static Dictionary<string, string> _strings = new();
        private static bool _initialized;

        public static string CurrentLocale => _currentLocale;

        /// <summary>
        /// Idempotent init. Reads saved locale from PlayerPrefs, falls back
        /// to system language, then to DefaultLocale.
        /// </summary>
        public static void EnsureInitialized()
        {
            if (_initialized) return;
            _initialized = true;

            string saved = PlayerPrefs.GetString(PlayerPrefsKey, "");
            if (!string.IsNullOrEmpty(saved))
            {
                LoadLocale(saved);
                return;
            }

            // Map Unity SystemLanguage to our locale codes (extend as needed)
            string sysLocale = Application.systemLanguage switch
            {
                SystemLanguage.Russian => "ru",
                SystemLanguage.Ukrainian => "ru",   // fallback
                _ => DefaultLocale,
            };
            LoadLocale(sysLocale);
        }

        public static void SetLocale(string locale)
        {
            if (locale == _currentLocale) return;
            LoadLocale(locale);
            PlayerPrefs.SetString(PlayerPrefsKey, locale);
            PlayerPrefs.Save();
            OnLocaleChanged?.Invoke();
        }

        private static void LoadLocale(string locale)
        {
            var ta = Resources.Load<TextAsset>($"Locales/{locale}");
            if (ta == null)
            {
                Debug.LogWarning($"[LocaleManager] Resources/Locales/{locale}.json not found, falling back to {DefaultLocale}");
                if (locale != DefaultLocale)
                {
                    LoadLocale(DefaultLocale);
                    return;
                }
                _strings = new Dictionary<string, string>();
                return;
            }
            _strings = JsonStringDictionary.Parse(ta.text);
            _currentLocale = locale;
        }

        /// <summary>
        /// Look up a localization key. Returns the key itself if not found
        /// (so missing translations are visible in-game, not silent).
        /// </summary>
        public static string Get(string key)
        {
            if (!_initialized) EnsureInitialized();
            return _strings.TryGetValue(key, out var value) ? value : key;
        }

        /// <summary>
        /// Get with positional substitution: LocaleManager.Get("hud.kills", killCount)
        /// Localized strings can use {0}, {1}, ... placeholders.
        /// </summary>
        public static string Get(string key, params object[] args)
        {
            string template = Get(key);
            try { return string.Format(template, args); }
            catch { return template; }
        }

        // --- Tiny inlined JSON-string-dictionary parser ---
        // Avoids pulling in Newtonsoft for a 16-string file. Handles the
        // exact shape Localization Assistant emits: { "key": "value", ... }
        // Nested values, arrays, escaped quotes inside values are NOT
        // supported on purpose — keep the file shape flat.
        private static class JsonStringDictionary
        {
            public static Dictionary<string, string> Parse(string json)
            {
                var dict = new Dictionary<string, string>(StringComparer.Ordinal);
                if (string.IsNullOrWhiteSpace(json)) return dict;
                int i = 0;
                int n = json.Length;
                while (i < n && json[i] != '{') i++;
                i++;
                while (i < n)
                {
                    while (i < n && (char.IsWhiteSpace(json[i]) || json[i] == ',')) i++;
                    if (i >= n || json[i] == '}') break;
                    if (json[i] != '"') { i++; continue; }
                    i++;
                    int keyStart = i;
                    while (i < n && json[i] != '"') i++;
                    string key = json.Substring(keyStart, i - keyStart);
                    i++;
                    while (i < n && (char.IsWhiteSpace(json[i]) || json[i] == ':')) i++;
                    if (i >= n || json[i] != '"') continue;
                    i++;
                    int valStart = i;
                    while (i < n && !(json[i] == '"' && json[i - 1] != '\\')) i++;
                    string val = json.Substring(valStart, i - valStart).Replace("\\\"", "\"").Replace("\\n", "\n");
                    dict[key] = val;
                    i++;
                }
                return dict;
            }
        }
    }
}
