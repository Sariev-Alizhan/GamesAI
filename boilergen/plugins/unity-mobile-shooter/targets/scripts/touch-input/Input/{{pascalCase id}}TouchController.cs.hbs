        private int _leftFingerId  = -1;
        private int _rightFingerId = -1;
        private float _yaw, _pitch;

        // ---- lifecycle ----
        private void Awake()
        {
            if (cameraTransform != null)
            {
                _yaw   = cameraTransform.eulerAngles.y;
