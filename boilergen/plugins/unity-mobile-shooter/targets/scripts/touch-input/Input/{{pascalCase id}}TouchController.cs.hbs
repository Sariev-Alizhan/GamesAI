        private void OnEnable()
        {
            if (fireButton    != null) fireButton.onClick.AddListener(OnFireTap);
            if (adsButton     != null) adsButton.onClick.AddListener(ToggleAds);
            if (sprintButton  != null) sprintButton.onClick.AddListener(ToggleSprint);
            if (reloadButton  != null) reloadButton.onClick.AddListener(OnReloadTap);
        }
        private void OnDisable()
        {
            if (fireButton    != null) fireButton.onClick.RemoveListener(OnFireTap);
            if (adsButton     != null) adsButton.onClick.RemoveListener(ToggleAds);
            if (sprintButton  != null) sprintButton.onClick.RemoveListener(ToggleSprint);
            if (reloadButton  != null) reloadButton.onClick.RemoveListener(OnReloadTap);
        }

        // ---- per-frame ----
        private void Update()
        {
            ReadTouches();
            ApplyLook();
        }

        // ---- touch sampling ----
        private void ReadTouches()
        {
            MoveInput = Vector2.zero;
            LookInput = Vector2.zero;

            for (int i = 0; i < UnityEngine.Input.touchCount; i++)
            {
                var t = UnityEngine.Input.GetTouch(i);
                Vector2 p = t.position;

                bool left  = p.x < Screen.width / 2f;
                bool right = p.x >= Screen.width / 2f;

                if (t.phase == TouchPhase.Began)
                {
                    if (left  && _leftFingerId  == -1) _leftFingerId  = t.fingerId;
                    if (right && _rightFingerId == -1) _rightFingerId = t.fingerId;
                }

                if (t.fingerId == _leftFingerId)
                {
                    Vector2 anchor = new(LEFT_STICK_X, LEFT_STICK_Y);
                    Vector2 delta = (p - anchor) / LEFT_STICK_RADIUS;
                    MoveInput = Vector2.ClampMagnitude(delta, 1f);
                }
                else if (t.fingerId == _rightFingerId)
                {
                    Vector2 prev = (Vector2)t.position - t.deltaPosition;
                    LookInput += (p - prev) / RIGHT_STICK_RADIUS;
                }

                if (t.phase is TouchPhase.Ended or TouchPhase.Canceled)
                {
                    if (t.fingerId == _leftFingerId)  _leftFingerId  = -1;
                    if (t.fingerId == _rightFingerId) _rightFingerId = -1;
                }
            }
        }

        private void ApplyLook()
        {
            if (cameraTransform == null) return;
            float mult = LOOK_SENSITIVITY * (IsAds ? ADS_LOOK_MULT : 1f);
            _yaw   += LookInput.x * mult;
            _pitch -= LookInput.y * mult * (INVERT_Y ? -1f : 1f);
            _pitch = Mathf.Clamp(_pitch, -85f, 85f);
            cameraTransform.rotation = Quaternion.Euler(_pitch, _yaw, 0f);
        }

        // ---- button handlers ----
