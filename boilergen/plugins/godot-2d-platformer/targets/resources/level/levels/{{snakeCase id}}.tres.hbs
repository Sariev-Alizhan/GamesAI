[gd_resource type="LevelData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/levels/{{snakeCase id}}.gd" id="1"]

[resource]
script = ExtResource("1")
id = "{{id}}"
display_name = "{{name}}"
