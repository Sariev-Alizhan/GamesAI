{
  "name": "boilergen",
  "version": "1.1.0",
  "description": "Open-source AI toolkit for game development. YAML entity descriptions → boilerplate code across stack layers (C++, Node, Flutter, Godot, Unity, Lua, FiveM-QB, i18n). Works as CLI, web playground, and MCP server (Cursor / Claude Code / Windsurf / Continue).",
  "main": "./dist/cli/index.js",
  "bin": {
    "boilergen": "./dist/cli/index.js",
    "boilergen-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "web": "tsx src/web/server.ts",
    "mcp": "tsx src/mcp/server.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "files": [
    "dist",
    "plugins",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "gamedev",
    "codegen",
    "yaml",
    "fivem",
    "qbcore",
    "unity",
    "godot",
    "unreal",
    "boilerplate",
    "scaffolding",
    "rp",
    "multiplayer",
    "localization",
    "i18n",
    "schema-validator",
    "mcp",
    "ai",
    "claude"
  ],
  "author": "Sariev Alizhan <raimzhan1907@gmail.com>",
  "license": "MIT",
  "homepage": "https://boilergen-eight.vercel.app/landing.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sariev-Alizhan/GamesAI.git",
    "directory": "boilergen"
  },
  "bugs": {
    "url": "https://github.com/Sariev-Alizhan/GamesAI/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "puppeteer": "^24.42.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/express": "^5.0.6",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "handlebars": "^4.7.9",
    "js-yaml": "^4.1.1",
    "zod": "^4.4.3"
  }
}
