{
  "name": "boilergen",
  "version": "1.0.0",
  "description": "Code generator for Grand Games projects. Turns YAML entity descriptions into boilerplate code across stack layers (C++, Node, Flutter).",
  "main": "./dist/cli/index.js",
  "bin": {
    "boilergen": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "web": "tsx src/web/server.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "handlebars": "^4.7.9",
    "js-yaml": "^4.1.1",
    "zod": "^4.4.1"
  }
}
