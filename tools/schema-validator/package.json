{
  "name": "schema-validator",
  "version": "0.2.0",
  "description": "Cross-reference validator for game data schemas (YAML/JSON) + FiveM resource graph linter (fxmanifest.lua, dependency case-mismatch, missing script files, cross-resource refs).",
  "type": "module",
  "main": "./dist/cli/index.js",
  "bin": {
    "schema-validator": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "license": "MIT",
  "author": "Sariev-Alizhan",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sariev-Alizhan/GamesAI",
    "directory": "tools/schema-validator"
  }
}
